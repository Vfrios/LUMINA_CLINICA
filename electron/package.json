{
  "name": "lumina-clinica",
  "version": "1.0.0",
  "description": "LÚMINA · Clínica de Estética e Biomedicina (visualizador 3D conceitual)",
  "main": "main.js",
  "scripts": {
    "prepare-web": "node -e \"require('fs').cpSync('../dist/web','app-web',{recursive:true})\"",
    "start": "npm run prepare-web && electron .",
    "make": "npm run prepare-web && electron-builder"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "br.lumina.clinica",
    "productName": "LÚMINA Clínica",
    "files": ["main.js", "app-web/**/*"],
    "win": { "target": "nsis" }, "mac": { "target": "dmg" }, "linux": { "target": "AppImage" }
  }
}
